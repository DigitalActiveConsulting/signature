<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= title %> | <%= Docuseal.product_name %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="color-scheme" content="light dark">
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=dac1">
    <%= render 'layouts/dacforge_fonts' %>
    <style>
      :root {
        --paper: #fafaf7;
        --ink: #0a0a0a;
        --muted: #6b6b6b;
        --rule: #d8d8d2;
        --accent: #d94925;
        --button-ink: #fafaf7;
      }

      @media (prefers-color-scheme: dark) {
        :root {
          --paper: #111110;
          --ink: #f1f0ea;
          --muted: #8a8a82;
          --rule: #2a2a26;
          --accent: #ef5a38;
          --button-ink: #111110;
        }
      }

      body {
        background-color: var(--paper);
        color: var(--ink);
        font-family: 'Inter', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
        -webkit-font-smoothing: antialiased;
        margin: 0;
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        text-align: center;
      }

      main {
        width: 100%;
        max-width: 32rem;
        padding: 3rem 1.5rem;
      }

      .brand {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        color: var(--ink);
        font-weight: 700;
        font-size: 1.25rem;
        text-decoration: none;
      }

      .code {
        font-family: 'Instrument Serif', ui-serif, Georgia, serif;
        font-weight: 400;
        font-size: clamp(6rem, 22vw, 9rem);
        line-height: 1;
        color: var(--accent);
        margin: 2.5rem 0 0.5rem;
      }

      h1 {
        font-family: 'Instrument Serif', ui-serif, Georgia, serif;
        font-weight: 400;
        font-size: 1.875rem;
        margin: 0 0 0.75rem;
      }

      p {
        color: var(--muted);
        margin: 0 0 2rem;
        line-height: 1.6;
      }

      .button {
        display: inline-block;
        background-color: var(--ink);
        color: var(--button-ink);
        padding: 0.875rem 1.75rem;
        border-radius: 999px;
        font-weight: 600;
        text-decoration: none;
      }

      .button:hover {
        background-color: var(--accent);
        color: #ffffff;
      }
    </style>
  </head>
  <body>
    <main>
      <a class="brand" href="/">
        <%= render 'shared/logo', width: 28, height: 28 %>
        <span><%= Docuseal.product_name %></span>
      </a>
      <div class="code"><%= code %></div>
      <h1><%= title %></h1>
      <p><%= message %></p>
      <a class="button" href="/">Back to homepage</a>
    </main>
  </body>
</html>

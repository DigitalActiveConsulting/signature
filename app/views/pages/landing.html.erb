<section class="flex items-center justify-center px-4 min-h-[60vh]">
  <div class="max-w-md mx-auto py-16 text-center">
    <%= render 'shared/logo', width: '72', height: '72', class: 'mx-auto' %>
    <h1 class="text-5xl mt-6 mb-4">Document signing</h1>
    <p class="text-lg text-base-content/70 mb-3">
      <%= Docuseal::PRODUCT_NAME %> uses this site to send contracts and documents for electronic signature.
    </p>
    <p class="text-base text-base-content/60 mb-10">
      Received a document to sign? Open the link in your email. You don't need an account.
    </p>
    <%= link_to t('sign_in'), new_user_session_path, class: 'base-button w-full sm:w-auto sm:px-12' %>
  </div>
</section>
<%= render 'shared/attribution', with_counter: true %>
